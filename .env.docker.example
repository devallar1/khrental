# === PostgreSQL Connection ===
# These must match POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD in docker-compose.yml
PG_DATABASE=khrental
PG_USER=khrental
PG_PASSWORD=changeme

# === Email Configuration (optional) ===
# If not set, emails are simulated (logged but not sent)
TWILIO_SENDGRID_API_KEY=
EMAIL_FROM=noreply@khrentals.com
EMAIL_FROM_NAME=KH Rentals

# === Evia Sign (optional) ===
VITE_EVIA_SIGN_CLIENT_ID=
EVIA_SIGN_CLIENT_SECRET=

# === Paperless-ngx (optional) ===
PAPERLESS_URL=http://host.docker.internal:8010
PAPERLESS_TOKEN=

# === ERPNext (optional) ===
ERPNEXT_URL=http://host.docker.internal:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
